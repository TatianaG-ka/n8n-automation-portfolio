{
  "name": "Email Triage - Extended v1.1 (Trello + Drive + Approval)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "email-triage-extended",
        "options": {
          "rawBody": false
        }
      },
      "id": "webhook-trigger",
      "name": "Webhook - From Main Flow",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -400,
        400
      ],
      "webhookId": "00000000-0000-0000-0000-000000000005"
    },
    {
      "parameters": {
        "jsCode": "try {\nconst item = $input.first().json;\nconst body = item.body || '';\nconst taskPrompt = `Na podstawie poniższej wiadomości email do firmy doradczej:\n\n1. Przygotuj zwięzłe streszczenie (maks. 300 znaków)\n2. Utwórz priorytetową listę zadań do wykonania (max 5 zadań)\n3. Określ deadline — ile dni roboczych na realizację (1-10)\n\nOdpowiedz WYŁĄCZNIE poprawnym JSON:\n{\"streszczenie\": \"...\", \"zadania\": [\"Zadanie 1\", \"Zadanie 2\"], \"deadline_dni\": 3}\n\nKategoria: ${item.category}\nNadawca: ${item.fromName} (${item.from})\nTemat: ${item.subject}\nTreść: ${body.substring(0, 2000)}\nPodsumowanie AI: ${item.summary}`;\nreturn [{ json: { ...item, taskPrompt } }];\n} catch (error) {\n  return [{ json: { ...($input.first()?.json || {}), _error: true, _errorMessage: error.message } }];\n}"
      },
      "id": "prep-task-prompt",
      "name": "Prepare Task Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -128,
        400
      ]
    },
    {
      "parameters": {
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"gpt-4o-mini\",\n  \"temperature\": 0.2,\n  \"max_tokens\": 400,\n  \"messages\": [\n    {\"role\": \"system\", \"content\": \"Jesteś asystentem firmy doradczej. Generujesz konkretne zadania na podstawie maili. Odpowiadasz WYŁĄCZNIE poprawnym JSON.\"},\n    {\"role\": \"user\", \"content\": {{ JSON.stringify($json.taskPrompt) }} }\n  ]\n}",
        "options": {}
      },
      "id": "ai-tasks",
      "name": "AI Generate Tasks",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        160,
        400
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "credentials": {
        "openAiApi": {
          "id": "CRED_ID_REPLACE_AFTER_IMPORT_2",
          "name": "OpenAI - REPLACE_AFTER_IMPORT"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "try {\nconst aiResponse = $input.first().json;\nconst prev = $('Prepare Task Prompt').first().json;\nlet streszczenie = prev.summary || 'Brak streszczenia';\nlet zadania = ['Przejrzyj mail i odpowiedz'];\nlet deadlineDni = 3;\ntry {\n  const raw = aiResponse.choices?.[0]?.message?.content || '';\n  const cleaned = raw.replace(/```json\\n?/g, '').replace(/```\\n?/g, '').trim();\n  const parsed = JSON.parse(cleaned);\n  if (parsed.streszczenie) streszczenie = parsed.streszczenie;\n  if (Array.isArray(parsed.zadania) && parsed.zadania.length > 0) zadania = parsed.zadania.slice(0, 7);\n  if (typeof parsed.deadline_dni === 'number') deadlineDni = Math.min(10, Math.max(1, parsed.deadline_dni));\n} catch(e) { /* fallback defaults */ }\nconst dueDate = new Date();\nlet daysAdded = 0;\nwhile (daysAdded < deadlineDni) {\n  dueDate.setDate(dueDate.getDate() + 1);\n  const day = dueDate.getDay();\n  if (day !== 0 && day !== 6) daysAdded++;\n}\nconst trelloLabels = { zapytanie_ofertowe: 'green', pytanie_klienta: 'blue', reklamacja_eskalacja: 'red', sprawy_fakturowe: 'yellow', wspolpraca_partnerstwo: 'purple', rekrutacja_cv: 'sky', zaproszenie_wydarzenie: 'lime', sprawy_prawne_umowy: 'orange', wiadomosc_systemowa: 'black', spam: 'black' };\nconst cardDesc = `**Od:** ${prev.fromName} <${prev.from}>\\n**Kategoria:** ${prev.categoryLabel || prev.category}\\n**Pilność:** ${prev.urgency}\\n**Przypisano:** ${prev.assignedPerson} (${prev.assignedRole})\\n\\n**Streszczenie:**\\n${streszczenie}\\n\\n**Draft odpowiedzi:**\\n${(prev.draftText || '').substring(0, 500)}`;\nreturn [{ json: { ...prev, streszczenie, zadania, deadlineDate: dueDate.toISOString(), deadlineDni, trelloLabelColor: trelloLabels[prev.category] || 'black', trelloCardName: prev.subject, trelloCardDesc: cardDesc } }];\n} catch (error) {\n  return [{ json: { ...($input.first()?.json || {}), _error: true, _errorMessage: error.message } }];\n}"
      },
