        "jsCode": "// =============================================\n// SLACK: Powiadomienie o nowym zadaniu\n// =============================================\n// Wejście: $input z \"Agreguj po checkliście\" → { json: { data: [...], count: N } }\n// Output: { slack_task_message, slack_user, slack_channel } dla downstream Slack nodes\n\nconst input = $input.first().json;\n// \"Agreguj po checkliście\" zwraca { data: [...], count: N } — bierzemy pierwszy item z data\nconst data = input.data?.[0] || input;\n\nconst cardUrl = data.cardUrl || '(brak linku)';\nconst pilneTag = data.isUrgent ? '🔴 *PILNE* — ' : '';\nconst categoryLabel = data.categoryLabel || data.category || 'brak kategorii';\nconst deadlineDate = data.deadlineDate\n  ? new Date(data.deadlineDate).toLocaleDateString('pl-PL')\n  : '(brak terminu)';\nconst deadlineDni = data.deadlineDni ?? '?';\nconst streszczenie = data.streszczenie || data.summary || '(brak streszczenia)';\n\nconst msg = `${pilneTag}📋 *Nowe zadanie przypisane do Ciebie*\n\n*Od klienta:* ${data.fromName || '(brak)'} (${data.from || '(brak email)'})\n*Temat:* ${data.subject || '(brak tematu)'}\n*Kategoria:* ${categoryLabel}\n*Deadline:* ${deadlineDni} dni roboczych (${deadlineDate})\n\n*Streszczenie:*\n${streszczenie}\n\n🔗 *Karta Trello:* ${cardUrl}\n\n_Sprawdź kartę w Trello — znajdziesz tam checklistę zadań i draft odpowiedzi do review._`;\n\nreturn [{\n  json: {\n    slack_task_message: msg,\n    slack_user: data.assignedSlackUserId || '',\n    slack_channel: data.assignedChannel || 'general',\n    // Pass through original data for downstream debugging\n    _source: { from: data.from, subject: data.subject, category: data.category }\n  }\n}];"
      },
      "id": "00000000-0000-0000-0000-000000000101",
      "name": "Buduj powiadomienie o zadaniu",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2032,
        400
      ]
    },
    {
      "parameters": {
        "jsCode": "// Aggregate: zbierz wszystkie itemy w jeden\nconst items = $input.all();\nconst allData = items.map(i => i.json);\nreturn [{ json: { data: allData, count: allData.length } }];"
      },
